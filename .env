# mock — использовать моковую "базу данных" в localStorage, без реального бэкенда
# real — ходить на настоящий бэкенд по VITE_API_BASE_URL
VITE_API_MODE=mock

# Используется только когда VITE_API_MODE=real
VITE_API_BASE_URL=/api

# AI-мэтчинг заявок (Gemini, бесплатный тариф). Ключ НЕ пишем сюда — .env закоммичен.
# Положи в .env.local (он в .gitignore):
#   VITE_GEMINI_API_KEY=твой_ключ
#   VITE_GEMINI_MODEL=gemini-3.5-flash   (необязательно, это значение по умолчанию)
